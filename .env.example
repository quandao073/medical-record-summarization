# Copy this file to .env and fill in your keys
# cp .env.example .env

# --- Week 2-3: OpenAI (PoC pipeline) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Week 3+: Anthropic Claude (migrating from OpenAI) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional: MLflow tracking server (default: local ./mlruns)
# MLFLOW_TRACKING_URI=http://localhost:5000

# --- Database (SQLite for local dev, PostgreSQL for Docker) ---
DATABASE_URL=sqlite+aiosqlite:///data/medical_records.db
POSTGRES_PASSWORD=devpassword
