# =============================================================================
# SECURITY: Never commit real patient data or credentials
# Synthetic test data in data/raw/ is tracked intentionally (is_synthetic=true)
# data/processed/ is EXCLUDED — contains assembled records with PII structure
# =============================================================================

# Environment & secrets — NEVER commit
.env
*.env.local
*.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# Data — processed/assembled output is excluded (regeneratable + PII structure)
# data/raw/ IS tracked (synthetic test fixtures, is_synthetic=true)
# data/dictionaries/ IS tracked (abbreviation dictionaries, no PII)
# =============================================================================
data/processed/
data/vietnamese-clinic-data-seeds/

# MLflow
mlruns/
mlartifacts/

# Pytest cache
.pytest_cache/
.cache/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Jupyter checkpoints
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Drafts — local working notes, not for review
drafts/

# Plans — internal planning docs, not for review
plans/

# Eval — gold labels and results are tracked (eval/gold/, eval/results/)
# Only exclude auto-generated case exports if any
eval/cases/

reports/

# Frontend (Next.js) — generated files not tracked
frontend/node_modules/
frontend/.next/
frontend/.env.local
data/cache/
